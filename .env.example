# Copy to .env.local and fill in. Never commit real keys.

# Gemini — vision (photo questions) and graphs. https://aistudio.google.com/apikey
# Comma-separated; keys from different Google Cloud projects have separate quotas.
GEMINI_API_KEYS=

# Groq — main solver and answer checker. https://console.groq.com/keys
# Comma-separated; keys from different Groq accounts have separate quotas.
GROQ_API_KEYS=

# Clerk — authentication. In development, Clerk "keyless mode" works without these.
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: PEM public key (Clerk dashboard > API keys) for verifying sessions without network calls.
CLERK_JWT_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/solve
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/solve

# Administrators: comma-separated sign-in emails that can open /admin.
ADMIN_EMAILS=
# Optional second step: the admin panel also asks for this username and password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional overrides (defaults shown).
# GROQ_SOLVER_MODEL=openai/gpt-oss-120b
# GROQ_CHECKER_MODELS=qwen/qwen3.8-27b,qwen/qwen3.6-27b,openai/gpt-oss-20b
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash
# Gemini sends no quota headers, so the app counts requests itself.
# Set these to the limits shown at https://aistudio.google.com/rate-limit
# GEMINI_RPM=10
# GEMINI_RPD=250
